# Environment Configuration for Production Deployment

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=compliance_db
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@db:5432/compliance_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security & JWT Secrets
SECRET_KEY=change_this_to_a_random_secure_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# AI Provider Selection (gemini | openai | mock)
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# App Metadata & CORS
PROJECT_NAME="Legal Metrology E-Commerce Compliance Checker"
VERSION="1.0.0"
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:5173", "http://localhost:80"]
